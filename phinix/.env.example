# ---------------------------------------------------------------------------
# PHINIX — environment template.  Copy to `.env.local` and fill in.
# Everything here is OPTIONAL: the site builds and runs without any of it.
# ---------------------------------------------------------------------------

# Canonical public URL (no trailing slash). Used for canonical tags, hreflang,
# sitemap, robots and JSON-LD. Change this when the domain is live.
NEXT_PUBLIC_SITE_URL="https://phinix.hu"

# Google Analytics 4 measurement id. When empty, no analytics and no consent
# banner are rendered at all (zero third-party requests).
NEXT_PUBLIC_GA_ID=""

# Contact form delivery -----------------------------------------------------
# Every enquiry goes to CONTACT_TO_EMAIL (default: the studio inbox).
#
# 1) SMTP — simplest with a plain Gmail account, no domain needed.
#    Google Account → Security → 2-Step Verification → App passwords →
#    create "Mail" → paste the 16-character password below.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="phinixwebsite@gmail.com"
SMTP_PASS=""                     # Gmail app password (NOT the login password)

# 2) Resend — alternative, needs a verified sending domain.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="PHINIX <no-reply@phinix.hu>"

# Where the form is delivered. Empty = siteConfig.formEmail.
CONTACT_TO_EMAIL="phinixwebsite@gmail.com"
CONTACT_FROM_NAME="PHINIX weboldal"

# Shared secret for POST /api/revalidate (ISR on-demand revalidation).
REVALIDATE_SECRET="change-me"
